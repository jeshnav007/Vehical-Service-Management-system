# Server Environment Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://vsm-website.onrender.com

# Firebase Admin SDK Configuration (Option 1: Complete JSON string or base64 string)
# Generate from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase Admin SDK Configuration (Option 2: Individual variables)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: Initial Admin Account Seed Setup
ADMIN_SEED_EMAIL=admin@vsm.com
ADMIN_SEED_PASSWORD=
